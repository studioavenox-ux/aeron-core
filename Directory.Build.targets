<Project>
  <Target Name="EnforceNet10LtsTargetFramework" BeforeTargets="BeforeBuild">
    <Error
      Condition="'$(TargetFramework)' != 'net10.0' And !$([System.String]::Copy('$(TargetFramework)').StartsWith('net10.0-windows'))"
      Text="AERON policy violation: project '$(MSBuildProjectName)' targets '$(TargetFramework)'. Only .NET 10 LTS ('net10.0' or 'net10.0-windows*') is permitted." />
  </Target>
</Project>
