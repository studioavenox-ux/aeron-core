index 0000000000000000000000000000000000000000..9d285ba3bf8a0cbf0a364f482a359274254111f4
--- /dev/null
+++ b/src/Aeron.Security/AuditLedger.cs
@@ -0,0 +1,96 @@
+using System.Buffers.Binary;
+using System.Security.Cryptography;
+using Aeron.Contracts;
+
+namespace Aeron.Security;
+
+/// <summary>
+/// Fixed-format, hash-chained ledger foundation. Requires a pre-existing file and a
+/// separately protected, rollback-resistant, durably provisioned checkpoint. Not wired
+/// into the application. Crash between file flush and checkpoint update fails closed.
+/// File access and checkpoint implementations must be protected against untrusted users.
+/// </summary>
+public sealed class AuditLedger : ISecurityAuditSink
+{
+    private const int RecordSize = 92; // sequence, kind, correlation id, previous hash, hash
+    private readonly string _path;
+    private readonly IProtectedAuditCheckpointStore _checkpoint;
+    private readonly Lock _sync = new();
+    private bool _unhealthy;
+
+    public AuditLedger(string existingFilePath, IProtectedAuditCheckpointStore checkpoint)
+    {
+        ArgumentException.ThrowIfNullOrWhiteSpace(existingFilePath);
+        ArgumentNullException.ThrowIfNull(checkpoint);
+        _path = existingFilePath;
+        _checkpoint = checkpoint;
+    }
+
+    public bool TryAppend(SecurityAuditKind kind, Guid correlationId)
+    {
+        lock (_sync)
+        {
+            if (_unhealthy || !Enum.IsDefined(kind) || correlationId == Guid.Empty) return false;
+            try
+            {
+                // Exclusive handle serializes cooperating processes and denies sharing on Windows.
+                using var file = new FileStream(_path, FileMode.Open, FileAccess.ReadWrite, FileShare.None);
+                if (!_checkpoint.TryRead(out var anchoredSequence, out var anchoredHash) ||
+                    anchoredSequence < 0 || anchoredHash is null || anchoredHash.Length != 32 ||
+                    !Verify(file, out var sequence, out var lastHash) ||
+                    sequence != anchoredSequence || !CryptographicOperations.FixedTimeEquals(lastHash, anchoredHash) ||
+                    sequence == long.MaxValue)
+                {
+                    _unhealthy = true;
+                    return false;
+                }
+
+                var record = new byte[RecordSize];
+                BinaryPrimitives.WriteInt64BigEndian(record.AsSpan(0, 8), sequence + 1);
+                BinaryPrimitives.WriteInt32BigEndian(record.AsSpan(8, 4), (int)kind);
+                if (!correlationId.TryWriteBytes(record.AsSpan(12, 16))) throw new InvalidOperationException();
+                lastHash.CopyTo(record, 28);
+                SHA256.HashData(record.AsSpan(0, 60), record.AsSpan(60, 32));
+                file.Position = file.Length;
+                file.Write(record);
+                file.Flush(flushToDisk: true);
+                if (!_checkpoint.TryWrite(sequence + 1, record.AsSpan(60, 32)))
+                {
+                    _unhealthy = true;
+                    return false;
+                }
+
+                return true;
+            }
+            catch (Exception)
+            {
+                _unhealthy = true;
+                return false;
+            }
+        }
+    }
+
+    private static bool Verify(FileStream file, out long sequence, out byte[] lastHash)
+    {
+        sequence = 0;
+        lastHash = new byte[32];
+        if (file.Length % RecordSize != 0) return false;
+        file.Position = 0;
+        var record = new byte[RecordSize];
+        Span<byte> actual = stackalloc byte[32];
+        while (file.Position < file.Length)
+        {
+            file.ReadExactly(record);
+            if (sequence == long.MaxValue || BinaryPrimitives.ReadInt64BigEndian(record.AsSpan(0, 8)) != sequence + 1 ||
+                !Enum.IsDefined((SecurityAuditKind)BinaryPrimitives.ReadInt32BigEndian(record.AsSpan(8, 4))) ||
+                new Guid(record.AsSpan(12, 16)) == Guid.Empty ||
+                !CryptographicOperations.FixedTimeEquals(record.AsSpan(28, 32), lastHash)) return false;
+            SHA256.HashData(record.AsSpan(0, 60), actual);
+            if (!CryptographicOperations.FixedTimeEquals(actual, record.AsSpan(60, 32))) return false;
+            record.AsSpan(60, 32).CopyTo(lastHash);
+            sequence++;
+        }
+
+        return true;
+    }
+}
diff --git a/src/Aeron.Security/AuthorityState.cs b/src/Aeron.Security/AuthorityState.cs
new file mode 100644
index 0000000000000000000000000000000000000000..19131efd523213e690f72aa55e0e0b3735a4e138
--- /dev/null
+++ b/src/Aeron.Security/AuthorityState.cs
@@ -0,0 +1,150 @@
+using Aeron.Contracts;
+
+namespace Aeron.Security;
+
+/// <summary>
+/// Volatile authority foundation, not an action dispatcher or production grant store.
+/// All methods serialize with each other; external dispatch and external identity changes
+/// are not atomic with this lock. Restart loses grants and sessions (default deny).
+/// Trusted provider and audit callbacks must not call back into this instance.
+/// </summary>
+public sealed class AuthorityState
+{
+    private readonly Lock _sync = new();
+    private readonly OwnerAuthorityGuard _authority;
+    private readonly ISecurityAuditSink _audit;
+    private readonly HashSet<(VerifiedIdentity Identity, SecurityAction Action)> _grants = [];
+    private readonly Dictionary<Guid, VerifiedIdentity> _sessions = [];
+    private readonly HashSet<VerifiedIdentity> _revokedAgents = [];
+    private bool _busy;
+    private bool _unhealthy;
+
+    public AuthorityState(ITrustedIdentityProvider identityProvider, ISecurityAuditSink audit)
+    {
+        ArgumentNullException.ThrowIfNull(identityProvider);
+        ArgumentNullException.ThrowIfNull(audit);
+        _authority = new OwnerAuthorityGuard(identityProvider);
+        _audit = audit;
+    }
+
+    public bool Grant(ReadOnlyMemory<byte> ownerEvidence, VerifiedIdentity target, SecurityAction action)
+    {
+        lock (_sync)
+        {
+            if (_busy || _unhealthy || !Valid(target, action)) return false;
+            _busy = true;
+            try
+            {
+                if (!_authority.VerifyOwner(ownerEvidence) || _revokedAgents.Contains(target) ||
+                    !Record(SecurityAuditKind.PermissionGranted)) return false;
+                _grants.Add((target, action));
+                return true;
+            }
+            finally { _busy = false; }
+        }
+    }
+
+    public bool RevokePermission(ReadOnlyMemory<byte> ownerEvidence, VerifiedIdentity target, SecurityAction action)
+    {
+        lock (_sync)
+        {
+            if (_busy || !Valid(target, action)) return false;
+            _busy = true;
+            try
+            {
+                if (!_authority.VerifyOwner(ownerEvidence)) return false;
+                _grants.Remove((target, action));
+                return Record(SecurityAuditKind.PermissionRevoked);
+            }
+            finally { _busy = false; }
+        }
+    }
+
+    public bool RevokeAgent(ReadOnlyMemory<byte> ownerEvidence, VerifiedIdentity agent)
+    {
+        lock (_sync)
+        {
+            if (_busy || !ValidIdentity(agent) || agent.Kind != IdentityKind.Agent) return false;
+            _busy = true;
+            try
+            {
+                if (!_authority.VerifyOwner(ownerEvidence)) return false;
+                _revokedAgents.Add(agent);
+                _grants.RemoveWhere(g => g.Identity == agent);
+                return Record(SecurityAuditKind.AgentRevoked);
+            }
+            finally { _busy = false; }
+        }
+    }
+
+    public bool RevokeSession(ReadOnlyMemory<byte> ownerEvidence, Guid sessionId)
+    {
+        lock (_sync)
+        {
+            if (_busy || sessionId == Guid.Empty) return false;
+            _busy = true;
+            try
+            {
+                if (!_authority.VerifyOwner(ownerEvidence)) return false;
+                _sessions.Remove(sessionId);
+                return Record(SecurityAuditKind.SessionRevoked);
+            }
+            finally { _busy = false; }
+        }
+    }
+
+    public bool TryOpenSession(ReadOnlyMemory<byte> evidence, out Guid sessionId)
+    {
+        lock (_sync)
+        {
+            sessionId = Guid.Empty;
+            if (_busy || _unhealthy) return false;
+            _busy = true;
+            try
+            {
+                if (!_authority.TryAuthenticate(evidence, out var identity, out _) ||
+                    identity is null || _revokedAgents.Contains(identity)) return false;
+                sessionId = Guid.NewGuid();
+                _sessions.Add(sessionId, identity);
+                return true;
+            }
+            finally { _busy = false; }
+        }
+    }
+
+    // A positive result is only a snapshot, never authority for a side effect.
+    public bool IsCurrentlyGranted(Guid sessionId, ReadOnlyMemory<byte> evidence, SecurityAction action)
+    {
+        lock (_sync)
+        {
+            if (_busy || _unhealthy || !Enum.IsDefined(action) || action == SecurityAction.Unknown) return false;
+            _busy = true;
+            try
+            {
+                return _sessions.TryGetValue(sessionId, out var sessionIdentity) &&
+                    _authority.TryAuthenticate(evidence, out var identity, out _) && identity == sessionIdentity &&
+                    !_revokedAgents.Contains(sessionIdentity) && _grants.Contains((sessionIdentity, action));
+            }
+            finally { _busy = false; }
+        }
+    }
+
+    private bool Record(SecurityAuditKind kind)
+    {
+        if (_unhealthy) return false;
+        try
+        {
+            if (_audit.TryAppend(kind, Guid.NewGuid())) return true;
+        }
+        catch (Exception) { }
+        _unhealthy = true;
+        return false;
+    }
+
+    private static bool Valid(VerifiedIdentity identity, SecurityAction action) =>
+        ValidIdentity(identity) && Enum.IsDefined(action) && action != SecurityAction.Unknown;
+
+    private static bool ValidIdentity(VerifiedIdentity? identity) => identity is not null &&
+        !string.IsNullOrWhiteSpace(identity.SubjectId) && identity.SubjectId.Length <= 256 &&
+        identity.Kind is IdentityKind.Owner or IdentityKind.Agent;
+}
