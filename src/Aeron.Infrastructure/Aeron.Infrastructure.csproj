<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Aeron.Infrastructure</RootNamespace>
    <AssemblyName>Aeron.Infrastructure</AssemblyName>
    <!-- Required by the [LibraryImport] source generator (DPAPI interop in
         DpapiDataProtector). The generated marshalling code uses pointers; no hand-written
         unsafe code exists in this assembly. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aeron.Contracts\Aeron.Contracts.csproj" />
    <ProjectReference Include="..\Aeron.Security\Aeron.Security.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Migrations\*.sql" />
  </ItemGroup>
</Project>
