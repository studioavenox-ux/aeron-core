diff --git a/src/Aeron.Security/OperationBinding.cs b/src/Aeron.Security/OperationBinding.cs
new file mode 100644
index 0000000000000000000000000000000000000000..5183a57e3a3fe00a05acdb9a29dbfaed42872aac
--- /dev/null
+++ b/src/Aeron.Security/OperationBinding.cs
@@ -0,0 +1,120 @@
+using System.Buffers.Binary;
+using System.Security.Cryptography;
+using System.Text;
+using Aeron.Contracts;
+
+namespace Aeron.Security;
+
+/// <summary>
+/// Versioned, length-framed HMAC for exact operation identity. The key is random and
+/// process-local: all bindings become unverifiable after disposal or restart. It is not
+/// a durable approval store and does not authenticate or dispatch an operation.
+/// </summary>
+public sealed class OperationBinding : IDisposable
+{
+    private static readonly UTF8Encoding StrictUtf8 = new(false, true);
+    private static readonly byte[] Domain = Encoding.ASCII.GetBytes("AERON-OPERATION-BINDING-V1");
+    private readonly Lock _sync = new();
+    private readonly byte[] _key = RandomNumberGenerator.GetBytes(32);
+    private bool _disposed;
+
+    public byte[] Compute(
+        Guid approvalId,
+        SecurityAction action,
+        string requestingSubject,
+        string target,
+        string policyVersion,
+        ReadOnlySpan<byte> exactParameters)
+    {
+        if (approvalId == Guid.Empty || !Enum.IsDefined(action) || action == SecurityAction.Unknown)
+        {
+            throw new ArgumentException("An approval ID and known action are required.");
+        }
+
+        ArgumentException.ThrowIfNullOrWhiteSpace(requestingSubject);
+        ArgumentException.ThrowIfNullOrWhiteSpace(target);
+        ArgumentException.ThrowIfNullOrWhiteSpace(policyVersion);
+
+        lock (_sync)
+        {
+            ObjectDisposedException.ThrowIf(_disposed, this);
+            using var hash = IncrementalHash.CreateHMAC(HashAlgorithmName.SHA256, _key);
+            AppendBytes(hash, Domain);
+            Span<byte> id = stackalloc byte[16];
+            if (!approvalId.TryWriteBytes(id))
+            {
+                throw new InvalidOperationException("Unable to encode approval ID.");
+            }
+
+            AppendBytes(hash, id);
+            Span<byte> encodedAction = stackalloc byte[sizeof(int)];
+            BinaryPrimitives.WriteInt32BigEndian(encodedAction, (int)action);
+            AppendBytes(hash, encodedAction);
+            AppendText(hash, requestingSubject);
+            AppendText(hash, target);
+            AppendText(hash, policyVersion);
+            AppendBytes(hash, exactParameters);
+            return hash.GetHashAndReset();
+        }
+    }
+
+    public bool Verify(
+        ReadOnlySpan<byte> expectedBinding,
+        Guid approvalId,
+        SecurityAction action,
+        string requestingSubject,
+        string target,
+        string policyVersion,
+        ReadOnlySpan<byte> exactParameters)
+    {
+        if (expectedBinding.Length != 32)
+        {
+            return false;
+        }
+
+        var actual = Compute(approvalId, action, requestingSubject, target, policyVersion, exactParameters);
+        try
+        {
+            return CryptographicOperations.FixedTimeEquals(expectedBinding, actual);
+        }
+        finally
+        {
+            CryptographicOperations.ZeroMemory(actual);
+        }
+    }
+
+    public void Dispose()
+    {
+        lock (_sync)
+        {
+            if (!_disposed)
+            {
+                CryptographicOperations.ZeroMemory(_key);
+                _disposed = true;
+            }
+        }
+    }
+
+    private static void AppendText(IncrementalHash hash, string value)
+    {
+        // Strict UTF-8 rejects invalid surrogate sequences instead of mapping distinct
+        // strings to the same replacement character. No normalization is performed.
+        var bytes = StrictUtf8.GetBytes(value);
+        try
+        {
+            AppendBytes(hash, bytes);
+        }
+        finally
+        {
+            CryptographicOperations.ZeroMemory(bytes);
+        }
+    }
+
+    private static void AppendBytes(IncrementalHash hash, ReadOnlySpan<byte> bytes)
+    {
+        Span<byte> length = stackalloc byte[sizeof(int)];
+        BinaryPrimitives.WriteInt32BigEndian(length, bytes.Length);
+        hash.AppendData(length);
+        hash.AppendData(bytes);
+    }
+}
diff --git a/src/Aeron.Security/OwnerApprovalService.cs b/src/Aeron.Security/OwnerApprovalService.cs
new file mode 100644
index 0000000000000000000000000000000000000000..f4bc4a2646f23554a333da0a1ae8ebf194379b79
--- /dev/null
+++ b/src/Aeron.Security/OwnerApprovalService.cs
@@ -0,0 +1,269 @@
+using System.Security.Cryptography;
+using Aeron.Contracts;
+
+namespace Aeron.Security;
+
+/// <summary>
+/// In-process, volatile approval state. Restart/disposal invalidates all approvals.
+/// Requires trusted identity, grants, clock and durable audit providers; none are
+/// configured by the production host yet. Consumption is not an external dispatch
+/// boundary and must not by itself be treated as permission to perform a side effect.
+/// </summary>
+public sealed class OwnerApprovalService : IDisposable
+{
+    // An unavailable capacity is safer than unbounded memory growth. No retention
+    // or deletion policy is implied by this volatile engineering limit.
+    private const int MaxVolatileApprovals = 1024;
+
+    private sealed class Entry(
+        SecurityRequest request, VerifiedIdentity identity, byte[] binding, DateTimeOffset expiresAt)
+    {
+        public SecurityRequest Request { get; } = request;
+        public VerifiedIdentity Identity { get; } = identity;
+        public byte[] Binding { get; } = binding;
+        public DateTimeOffset ExpiresAt { get; } = expiresAt;
+        public ApprovalStatus Status { get; set; } = ApprovalStatus.Pending;
+    }
+
+    private readonly Lock _sync = new();
+    private readonly Dictionary<Guid, Entry> _entries = [];
+    private readonly PolicyDecisionEngine _policy;
+    private readonly OwnerAuthorityGuard _authority;
+    private readonly IClock _clock;
+    private readonly IApprovalAuditSink _audit;
+    private readonly OperationBinding _binding = new();
+    private bool _disposed;
+    private bool _insideAudit;
+    private bool _auditUnhealthy;
+
+    public OwnerApprovalService(ITrustedIdentityProvider identityProvider, IPermissionGrantStore grants, IClock clock, IApprovalAuditSink audit)
+    {
+        ArgumentNullException.ThrowIfNull(identityProvider);
+        ArgumentNullException.ThrowIfNull(grants);
+        ArgumentNullException.ThrowIfNull(clock);
+        ArgumentNullException.ThrowIfNull(audit);
+        _policy = new PolicyDecisionEngine(identityProvider, grants);
+        _authority = new OwnerAuthorityGuard(identityProvider);
+        _clock = clock;
+        _audit = audit;
+    }
+
+    public ApprovalResult Request(
+        SecurityRequest request, ReadOnlyMemory<byte> actorEvidence, string target,
+        ReadOnlySpan<byte> exactParameters, DateTimeOffset expiresAt)
+    {
+        lock (_sync)
+        {
+            if (_disposed || _insideAudit)
+            {
+                return Rejected();
+            }
+
+            if (_auditUnhealthy)
+            {
+                return AuditUnavailable();
+            }
+
+            try
+            {
+                var decision = _policy.EvaluateAndIdentify(request, actorEvidence, out var identity);
+                if (decision.Disposition != PolicyDisposition.RequireOwnerApproval || identity is null ||
+                    expiresAt <= _clock.UtcNow || _entries.Count >= MaxVolatileApprovals)
+                {
+                    return RejectAudited();
+                }
+
+                var id = Guid.NewGuid();
+                var digest = _binding.Compute(id, request.Action, identity.SubjectId, target, request.PolicyVersion, exactParameters);
+                if (!Record(id, ApprovalEventKind.Requested))
+                {
+                    CryptographicOperations.ZeroMemory(digest);
+                    return AuditUnavailable();
+                }
+
+                _entries.Add(id, new Entry(request, identity, digest, expiresAt));
+                return new ApprovalResult(ApprovalResultCode.Success, id);
+            }
+            catch (Exception)
+            {
+                return RejectAudited();
+            }
+        }
+    }
+
+    public ApprovalResult Decide(Guid id, ReadOnlyMemory<byte> ownerEvidence, bool approve)
+    {
+        lock (_sync)
+        {
+            if (_disposed || _insideAudit)
+            {
+                return Rejected();
+            }
+
+            if (_auditUnhealthy)
+            {
+                return AuditUnavailable();
+            }
+
+            try
+            {
+                if (!_authority.VerifyOwner(ownerEvidence) || !_entries.TryGetValue(id, out var entry) ||
+                    entry.Status != ApprovalStatus.Pending || IsExpired(id, entry))
+                {
+                    return RejectAudited();
+                }
+
+                var kind = approve ? ApprovalEventKind.Approved : ApprovalEventKind.Denied;
+                if (!Record(id, kind))
+                {
+                    return AuditUnavailable();
+                }
+
+                entry.Status = approve ? ApprovalStatus.Approved : ApprovalStatus.Denied;
+                return new ApprovalResult(ApprovalResultCode.Success, id);
+            }
+            catch (Exception)
+            {
+                return RejectAudited();
+            }
+        }
+    }
+
+    public ApprovalResult Cancel(Guid id, ReadOnlyMemory<byte> ownerEvidence) =>
+        Invalidate(id, ownerEvidence, ApprovalStatus.Cancelled, ApprovalEventKind.Cancelled);
+
+    public ApprovalResult Revoke(Guid id, ReadOnlyMemory<byte> ownerEvidence) =>
+        Invalidate(id, ownerEvidence, ApprovalStatus.Revoked, ApprovalEventKind.Revoked);
+
+    public ApprovalResult Consume(
+        Guid id, SecurityRequest request, ReadOnlyMemory<byte> actorEvidence,
+        string target, ReadOnlySpan<byte> exactParameters)
+    {
+        lock (_sync)
+        {
+            if (_disposed || _insideAudit)
+            {
+                return Rejected();
+            }
+
+            if (_auditUnhealthy)
+            {
+                return AuditUnavailable();
+            }
+
+            try
+            {
+                if (!_entries.TryGetValue(id, out var entry) || entry.Status != ApprovalStatus.Approved || IsExpired(id, entry))
+                {
+                    return RejectAudited();
+                }
+
+                var decision = _policy.EvaluateAndIdentify(request, actorEvidence, out var identity);
+                if (decision.Disposition != PolicyDisposition.RequireOwnerApproval || identity is null ||
+                    request != entry.Request || identity != entry.Identity ||
+                    !_binding.Verify(entry.Binding, id, request.Action, identity.SubjectId, target, request.PolicyVersion, exactParameters))
+                {
+                    return RejectAudited();
+                }
+
+                if (!Record(id, ApprovalEventKind.Consumed))
+                {
+                    return AuditUnavailable();
+                }
+
+                entry.Status = ApprovalStatus.Consumed;
+                return new ApprovalResult(ApprovalResultCode.Success, id);
+            }
+            catch (Exception)
+            {
+                return RejectAudited();
+            }
+        }
+    }
+
+    private ApprovalResult Invalidate(Guid id, ReadOnlyMemory<byte> ownerEvidence, ApprovalStatus status, ApprovalEventKind kind)
+    {
+        lock (_sync)
+        {
+            if (_disposed || _insideAudit)
+            {
+                return Rejected();
+            }
+
+            if (!_authority.VerifyOwner(ownerEvidence) || !_entries.TryGetValue(id, out var entry) ||
+                entry.Status is not (ApprovalStatus.Pending or ApprovalStatus.Approved))
+            {
+                return RejectAudited();
+            }
+
+            // Revocation wins even if the audit sink is unhealthy. The caller is told
+            // about audit failure rather than silently reverting the revocation.
+            entry.Status = status;
+            var recorded = Record(id, kind);
+            return recorded && !_auditUnhealthy ? new ApprovalResult(ApprovalResultCode.Success, id) : AuditUnavailable();
+        }
+    }
+
+    private bool IsExpired(Guid id, Entry entry)
+    {
+        if (entry.ExpiresAt <= _clock.UtcNow)
+        {
+            // Once observed expired, a later backwards wall-clock change cannot revive it.
+            entry.Status = ApprovalStatus.Revoked;
+            _ = Record(id, ApprovalEventKind.Expired);
+            return true;
+        }
+
+        return false;
+    }
+
+    private bool Record(Guid id, ApprovalEventKind kind)
+    {
+        try
+        {
+            _insideAudit = true;
+            var recorded = _audit.TryAppend(new ApprovalAuditEvent(id, kind)) && !_disposed;
+            if (!recorded)
+            {
+                _auditUnhealthy = true;
+            }
+
+            return recorded;
+        }
+        catch (Exception)
+        {
+            _auditUnhealthy = true;
+            return false;
+        }
+        finally
+        {
+            _insideAudit = false;
+        }
+    }
+
+    private ApprovalResult RejectAudited() =>
+        !_auditUnhealthy && Record(Guid.Empty, ApprovalEventKind.Rejected) ? Rejected() : AuditUnavailable();
+
+    private static ApprovalResult Rejected() => new(ApprovalResultCode.Rejected, Guid.Empty);
+    private static ApprovalResult AuditUnavailable() => new(ApprovalResultCode.AuditUnavailable, Guid.Empty);
+
+    public void Dispose()
+    {
+        lock (_sync)
+        {
+            if (_disposed)
+            {
+                return;
+            }
+
+            _disposed = true;
+            foreach (var entry in _entries.Values)
+            {
+                CryptographicOperations.ZeroMemory(entry.Binding);
+            }
+
+            _entries.Clear();
+            _binding.Dispose();
+        }
+    }
+}
diff --git a/src/Aeron.Security/OwnerAuthorityGuard.cs b/src/Aeron.Security/OwnerAuthorityGuard.cs
new file mode 100644
index 0000000000000000000000000000000000000000..8079ad1793bd0edf7af6b1b6990bd62d31332923
--- /dev/null
+++ b/src/Aeron.Security/OwnerAuthorityGuard.cs
@@ -0,0 +1,62 @@
+using Aeron.Contracts;
+
+namespace Aeron.Security;
+
+/// <summary>
+/// Authenticates through an explicitly supplied trusted provider. This guard does not
+/// provide MFA or OS isolation; a missing or failing provider is never an Owner identity.
+/// </summary>
+public sealed class OwnerAuthorityGuard
+{
+    private readonly ITrustedIdentityProvider? _identityProvider;
+
+    public OwnerAuthorityGuard(ITrustedIdentityProvider? identityProvider)
+    {
+        _identityProvider = identityProvider;
+    }
+
+    public bool VerifyOwner(ReadOnlyMemory<byte> evidence) =>
+        TryAuthenticate(evidence, out var identity, out _) && identity!.Kind == IdentityKind.Owner;
+
+    internal bool TryAuthenticate(
+        ReadOnlyMemory<byte> evidence,
+        out VerifiedIdentity? identity,
+        out PolicyReason reason)
+    {
+        identity = null;
+        if (_identityProvider is null)
+        {
+            reason = PolicyReason.IdentityProviderUnavailable;
+            return false;
+        }
+
+        if (evidence.IsEmpty)
+        {
+            reason = PolicyReason.IdentityRejected;
+            return false;
+        }
+
+        try
+        {
+            if (!_identityProvider.TryAuthenticate(evidence, out var verified) ||
+                verified is null ||
+                string.IsNullOrWhiteSpace(verified.SubjectId) ||
+                verified.SubjectId.Length > 256 ||
+                (verified.Kind != IdentityKind.Owner && verified.Kind != IdentityKind.Agent))
+            {
+                reason = PolicyReason.IdentityRejected;
+                return false;
+            }
+
+            identity = verified;
+            reason = PolicyReason.Allowed;
+            return true;
+        }
+        catch (Exception)
+        {
+            // Provider failures must not become authentication successes or leak evidence.
+            reason = PolicyReason.IdentityRejected;
+            return false;
+        }
+    }
+}
diff --git a/src/Aeron.Security/PolicyDecisionEngine.cs b/src/Aeron.Security/PolicyDecisionEngine.cs
new file mode 100644
index 0000000000000000000000000000000000000000..be4c42e14615cd1bfca930ba6b173d9ca3e5d061
--- /dev/null
+++ b/src/Aeron.Security/PolicyDecisionEngine.cs
@@ -0,0 +1,132 @@
+using Aeron.Contracts;
+
+namespace Aeron.Security;
+
+/// <summary>
+/// A conservative engineering policy for the constraints in CONSTRAINTS.md. Requests
+/// must originate at a trusted action boundary. RequireOwnerApproval is not permission
+/// to execute; approval consumption and dispatch are not yet implemented here.
+/// </summary>
+public sealed class PolicyDecisionEngine : ISecurityPolicy
+{
+    public const string CurrentPolicyVersion = "m2-boundary-1";
+
+    private readonly OwnerAuthorityGuard _authority;
+    private readonly IPermissionGrantStore? _grants;
+
+    public PolicyDecisionEngine(ITrustedIdentityProvider? identityProvider, IPermissionGrantStore? grants)
+    {
+        _authority = new OwnerAuthorityGuard(identityProvider);
+        _grants = grants;
+    }
+
+    public SecurityDecision Evaluate(SecurityRequest? request, ReadOnlyMemory<byte> identityEvidence) =>
+        EvaluateAndIdentify(request, identityEvidence, out _);
+
+    internal SecurityDecision EvaluateAndIdentify(
+        SecurityRequest? request,
+        ReadOnlyMemory<byte> identityEvidence,
+        out VerifiedIdentity? identity)
+    {
+        identity = null;
+        if (request is null ||
+            !Enum.IsDefined(request.Action) || request.Action == SecurityAction.Unknown ||
+            !Enum.IsDefined(request.Sensitivity) || request.Sensitivity == DataSensitivity.Unknown)
+        {
+            return Decision(PolicyDisposition.Deny, PolicyReason.InvalidRequest);
+        }
+
+        if (!string.Equals(request.PolicyVersion, CurrentPolicyVersion, StringComparison.Ordinal))
+        {
+            return Decision(PolicyDisposition.Deny, PolicyReason.PolicyVersionMismatch);
+        }
+
+        var (tier, domains) = MapAction(request.Action);
+        if (tier == LocalAuthorityTier.L3)
+        {
+            return Decision(PolicyDisposition.Deny, PolicyReason.ForbiddenAction, tier, domains);
+        }
+
+        if (request.Sensitivity == DataSensitivity.Secret)
+        {
+            // No general-purpose operation is authorized to handle credentials in this
+            // initial boundary. Vault access needs a separate, explicitly defined path.
+            return Decision(PolicyDisposition.Deny, PolicyReason.SecretDisclosureForbidden, tier, domains);
+        }
+
+        if (request.Sensitivity == DataSensitivity.LocalPrivate && domains != GovernanceDomain.None)
+        {
+            domains |= GovernanceDomain.G2;
+        }
+
+        if (!_authority.TryAuthenticate(identityEvidence, out identity, out var identityReason))
+        {
+            return Decision(PolicyDisposition.Deny, identityReason, tier, domains);
+        }
+
+        if (request.Action == SecurityAction.ChangeAuthority && identity!.Kind != IdentityKind.Owner)
+        {
+            return Decision(PolicyDisposition.Deny, PolicyReason.OwnerRequired, tier, domains);
+        }
+
+        if (_grants is null)
+        {
+            return Decision(PolicyDisposition.Deny, PolicyReason.PermissionStoreUnavailable, tier, domains);
+        }
+
+        try
+        {
+            if (!_grants.IsGranted(identity!, request.Action))
+            {
+                return Decision(PolicyDisposition.Deny, PolicyReason.PermissionDenied, tier, domains);
+            }
+        }
+        catch (Exception)
+        {
+            return Decision(PolicyDisposition.Deny, PolicyReason.PermissionStoreUnavailable, tier, domains);
+        }
+
+        // Local reads also require a trusted path/scope boundary; this policy does
+        // not yet receive a resolved handle or protect against path substitution.
+        if (request.Action == SecurityAction.ReadLocalData)
+        {
+            return Decision(PolicyDisposition.Deny, PolicyReason.ScopeValidationUnavailable, tier, domains);
+        }
+
+        // No verified $0 gateway/provider/model policy exists in this phase. Do not
+        // substitute an unverified endpoint or a paid/local fallback.
+        if ((domains & GovernanceDomain.G1) != 0)
+        {
+            return Decision(PolicyDisposition.Deny, PolicyReason.GatewayPolicyUnavailable, tier, domains);
+        }
+
+        if (tier == LocalAuthorityTier.L2 ||
+            (domains & (GovernanceDomain.G2 | GovernanceDomain.G3 | GovernanceDomain.G4)) != 0)
+        {
+            return Decision(PolicyDisposition.RequireOwnerApproval, PolicyReason.ApprovalRequired, tier, domains);
+        }
+
+        return Decision(PolicyDisposition.Allow, PolicyReason.Allowed, tier, domains);
+    }
+
+    private static (LocalAuthorityTier Tier, GovernanceDomain Domains) MapAction(SecurityAction action) => action switch
+    {
+        SecurityAction.ReadApplicationState => (LocalAuthorityTier.L0, GovernanceDomain.None),
+        SecurityAction.ReadLocalData => (LocalAuthorityTier.L1, GovernanceDomain.None),
+        SecurityAction.ModifyLocalData => (LocalAuthorityTier.L2, GovernanceDomain.None),
+        SecurityAction.RemoteInference => (LocalAuthorityTier.None, GovernanceDomain.G1),
+        SecurityAction.DiscloseData => (LocalAuthorityTier.None, GovernanceDomain.G2),
+        SecurityAction.SendCommunication => (LocalAuthorityTier.None, GovernanceDomain.G3),
+        SecurityAction.ModifyExternalAccount => (LocalAuthorityTier.None, GovernanceDomain.G4),
+        SecurityAction.ChangeAuthority => (LocalAuthorityTier.L2, GovernanceDomain.None),
+        SecurityAction.ExecuteSkillScript => (LocalAuthorityTier.L3, GovernanceDomain.None),
+        _ => (LocalAuthorityTier.L3, GovernanceDomain.None)
+    };
+
+    private static SecurityDecision Decision(
+        PolicyDisposition disposition,
+        PolicyReason reason,
+        LocalAuthorityTier tier = LocalAuthorityTier.None,
+        GovernanceDomain domains = GovernanceDomain.None) =>
+        new(disposition, reason, CurrentPolicyVersion, tier, domains);
+}
