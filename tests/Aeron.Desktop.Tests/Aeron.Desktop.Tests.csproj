<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Aeron.Desktop.Tests</RootNamespace>
    <AssemblyName>Aeron.Desktop.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Aeron.Contracts\Aeron.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Aeron.Infrastructure\Aeron.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Aeron.Security\Aeron.Security.csproj" />
    <ProjectReference Include="..\..\src\Aeron.Core\Aeron.Core.csproj" />
    <ProjectReference Include="..\..\src\Aeron.Desktop\Aeron.Desktop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\shared\KernelTestHarness.cs" Link="M2\KernelTestHarness.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
