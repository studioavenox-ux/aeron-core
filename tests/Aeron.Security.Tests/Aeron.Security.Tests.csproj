<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Aeron.Security.Tests</RootNamespace>
    <AssemblyName>Aeron.Security.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Aeron.Contracts\Aeron.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Aeron.Security\Aeron.Security.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared kernel harness: one authoritative copy, compiled into each suite that needs
         it. A project reference between test projects would duplicate test discovery. -->
    <Compile Include="..\shared\KernelTestHarness.cs" Link="M2\KernelTestHarness.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
